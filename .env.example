# Required — the agent's model.
ANTHROPIC_API_KEY=

# Required for live web search. Without it, `web_search` degrades gracefully:
# it returns a note telling the agent to rely on the structured directory and
# to flag that reputation data was not checked.
TAVILY_API_KEY=

# Observability. These are the current LangSmith variable names, and the older
# LANGCHAIN_* ones still resolve — but not simply as a fallback. langsmith looks
# up TRACING_V2 across both namespaces before it looks at TRACING at all:
#
#   LANGSMITH_TRACING_V2 -> LANGCHAIN_TRACING_V2 -> LANGSMITH_TRACING -> LANGCHAIN_TRACING
#
# so a stale `LANGCHAIN_TRACING_V2=false` exported in your shell beats the
# LANGSMITH_TRACING below and silently disables tracing. Unset the old names
# rather than setting both. (The API key is a plain fallback: LANGSMITH_API_KEY
# then LANGCHAIN_API_KEY.)
#
# A trace carries every prompt, tool result and file write in full, for every
# user, into this one project — so it is outside the per-user isolation the
# store enforces. README's "Tracing" section has what each trace is tagged with.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=event-planner-agent

# Optional — overrides where the BROWSER UI keeps checkpoints and the store.
# The CLI never reads it; it takes `--db`. So setting this alone splits the two
# front ends onto different databases and a plan started in the terminal stops
# resuming in the browser — pass the CLI the same path with `--db`. Defaults to
# .state/planner.sqlite, which must stay outside the agent's filesystem root
# (src/event_planner/workspace/) — a database beneath it would expose every
# user's memories in raw form, bypassing namespacing. Both front ends refuse a
# path that lands there.
EVENT_PLANNER_DB=
