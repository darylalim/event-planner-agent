# Required — the agent's model.
ANTHROPIC_API_KEY=

# Required for live web search. Without it, `web_search` degrades gracefully:
# it returns a note telling the agent to rely on the structured directory and
# to flag that reputation data was not checked.
TAVILY_API_KEY=

# Observability. These are the current LangSmith variable names. The older
# LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY names still resolve as a fallback,
# so set one pair or the other rather than both.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=event-planner-agent
