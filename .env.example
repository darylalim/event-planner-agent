# Required — the agent's model.
ANTHROPIC_API_KEY=

# Required for live web search. Without it, `web_search` degrades gracefully:
# it returns a note telling the agent to rely on the structured directory and
# to flag that reputation data was not checked.
TAVILY_API_KEY=

# Observability. These are the current LangSmith variable names, and the older
# LANGCHAIN_* ones still resolve — but not simply as a fallback. langsmith looks
# up TRACING_V2 across both namespaces before it looks at TRACING at all:
#
#   LANGSMITH_TRACING_V2 -> LANGCHAIN_TRACING_V2 -> LANGSMITH_TRACING -> LANGCHAIN_TRACING
#
# so a stale `LANGCHAIN_TRACING_V2=false` exported in your shell beats the
# LANGSMITH_TRACING below and silently disables tracing. Unset the old names
# rather than setting both. (The API key is a plain fallback: LANGSMITH_API_KEY
# then LANGCHAIN_API_KEY.)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=event-planner-agent
